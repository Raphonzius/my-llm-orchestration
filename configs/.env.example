# llm-orchestration environment configuration

# === Paths ===
VAULT_PATH=~/vault
VAULT_RAW_DIR=_inbox

# === Desktop Server (always-on) ===
DESKTOP_HOST=192.168.1.XXX
# Or use hostname: DESKTOP_HOST=desktop.local

# === Ollama ===
OLLAMA_DESKTOP_URL=http://${DESKTOP_HOST}:11434
OLLAMA_LOCAL_URL=http://localhost:11434

# Router model (runs on ultrabook)
ROUTER_MODEL=gemma4:e2b

# Execution models
TIER1_MODEL=gemma4:e4b
TIER2_MODEL=gemma4:27b

# Embedding model (runs on desktop GPU)
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIM=1024

# === Qdrant (Desktop) ===
QDRANT_URL=http://${DESKTOP_HOST}:6333
QDRANT_COLLECTION_ATLAS=atlas
QDRANT_COLLECTION_SOURCES=sources
QDRANT_COLLECTION_PROJECTS=projects
QDRANT_COLLECTION_AREAS=areas

# === ChromaDB (Ultrabook local) ===
CHROMADB_URL=http://localhost:8000
CHROMADB_COLLECTION_RECENT=recent
CHROMADB_COLLECTION_CONVERSATIONS=conversations
CHROMADB_COLLECTION_WORKSPACE=workspace
CHROMADB_RECENT_DAYS=30

# === n8n (Desktop) ===
N8N_URL=http://${DESKTOP_HOST}:5678
N8N_WEBHOOK_SECRET=change-me-to-random-string

# === Gitea (Desktop) ===
GITEA_URL=http://${DESKTOP_HOST}:3000
GITEA_VAULT_REPO=rafael/vault

# === Claude API ===
ANTHROPIC_API_KEY=sk-ant-XXXXX
CLAUDE_MODEL=claude-sonnet-4-20250514
