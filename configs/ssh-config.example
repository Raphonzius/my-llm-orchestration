# Template for ~/.ssh/config on the ultrabook
# Non-sensitive: no keys, no usernames — replace placeholders before use.
#
# Tunnel ports chosen so ultrabook can run its own Ollama on 11434
# while reaching the desktop's Ollama via 21434.

Host nexus
    HostName 192.168.0.112
    User <desktop-username>
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

    # Keep the connection alive
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes

    # Port forwards — desktop service at 127.0.0.1:X → ultrabook 2X
    LocalForward 21434 127.0.0.1:11434    # Ollama
    LocalForward 26333 127.0.0.1:6333     # Qdrant REST
    LocalForward 26334 127.0.0.1:6334     # Qdrant gRPC
    LocalForward 25678 127.0.0.1:5678     # n8n

    # Fail fast if the tunnel can't be established — lets the retry loop try again
    ConnectTimeout 10
    ExitOnForwardFailure yes
