    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.text || '';\n\n// get LAST code fence\nconst fenceMatches = [...raw.matchAll(/```(?:json)?\\s*([\\s\\S]*?)```/g)];\nlet jsonStr = fenceMatches.length > 0 ? fenceMatches[fenceMatches.length - 1][1] : (raw.match(/(\\{[\\s\\S]*\\})/) || ['', '{}'])[1];\n\nlet meta = {};\ntry {\n    meta = JSON.parse(jsonStr.trim());\n} catch (e) {\n    meta = {};\n}\n\nreturn {\n    clip_path: $('split-clips').item.json.clip_path, content: $('read-clip').item.json.content, metadata: {\n        title: meta.title || 'Untitled',\n        summary: meta.summary || '',\n        domain: meta.domain || 'misc',\n        tags: meta.tags || [],\n        entities: meta.entities || [],\n        key_claims: meta.key_claims || []\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "id": "3b69ee09-1c3f-4bc4-a546-6ba2bfed4999",
      "name": "parse-metadata"
