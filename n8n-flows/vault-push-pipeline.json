    {
      "parameters": {
        "jsCode": "const all = $input.all();\nreturn [{\n    json: {\n        processed: all.length,\n        created: all.filter(i => i.json.action === 'created').length,\n        merged: all.filter(i => i.json.action === 'merged').length,\n        paths: all.map(i => i.json.atlas_path)\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
