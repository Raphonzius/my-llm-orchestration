    {
      "parameters": {
        "model": "gemma4:e2b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [-728, 96],
      "id": "d1e2f3a4-0004-4000-8000-000000000004",
      "name": "llm-gemma4-e2b",
      "credentials": {
        "ollamaApi": {
          "id": "QEuzv5uQ8e5xcGFh",
          "name": "ollama-desktop"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.query }}",
        "messages": {
          "messageValues": [
            {
              "message": "/no_think\n\nYou are a query router. Classify the query into exactly one tier.\nReturn ONLY JSON in a ```json code fence: {\"tier\": 1|2|3, \"domain\": [\"tag\"], \"reason\": \"one sentence\"}\n\nTier 1 (gemma4:e4b — fast, local): lookup, classification, yes/no, draft, template fill, short answers\nTier 2 (gemma4:26b — GPU): code generation, summarization, analysis, RAG synthesis, multi-paragraph output\nTier 3 (claude — API, expensive): multi-step reasoning, planning, judgment calls, final user-facing output\n\nNever route to tier 3 for anything a local model can handle."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [-728, -96],
      "id": "d1e2f3a4-0005-4000-8000-000000000005",
      "name": "classify-chain"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.text || '';\nconst fenceMatches = [...raw.matchAll(/```(?:json)?\\s*([\\s\\S]*?)```/g)];\nlet jsonStr = fenceMatches.length > 0\n  ? fenceMatches[fenceMatches.length - 1][1]\n  : (raw.match(/(\\{[\\s\\S]*?\\})/) || ['', '{}'])[1];\nlet cls = {};\ntry { cls = JSON.parse(jsonStr.trim()); } catch(e) { cls = {}; }\nconst forceTier = $('normalize-route-payload').first().json.force_tier || 0;\nreturn {\n  query: $('normalize-route-payload').first().json.query,\n  context: $('normalize-route-payload').first().json.context,\n  tier: forceTier > 0 ? forceTier : (cls.tier || 2),\n  domain: cls.domain || [],\n  reason: cls.reason || ''\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-504, -96],
      "id": "d1e2f3a4-0006-4000-8000-000000000006",
      "name": "parse-classification"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  query: $('normalize-route-payload').first().json.query,\n  context: $('normalize-route-payload').first().json.context,\n  tier: $('normalize-route-payload').first().json.force_tier,\n  domain: [],\n  reason: 'forced'\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-728, -288],
      "id": "d1e2f3a4-0007-4000-8000-000000000007",
      "name": "apply-force-tier"
    },
    {
      "parameters": {
        "dataType": "number",
        "value1": "={{ $json.tier }}",
        "rules": {
          "rules": [
            {"value2": 1, "outputKey": "1"},
            {"value2": 2, "outputKey": "2"},
            {"value2": 3, "outputKey": "3"}
          ]
        },
        "fallbackOutput": "extra"
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [-280, -96],
      "id": "d1e2f3a4-0008-4000-8000-000000000008",
      "name": "dispatch-tier"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "gemma4:e4b"},
            {"name": "prompt", "value": "={{ $json.query }}"},
            {"name": "stream", "value": false}
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-56, -288],
      "id": "d1e2f3a4-0009-4000-8000-000000000009",
      "name": "call-tier1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "gemma4:26b"},
            {"name": "prompt", "value": "={{ $json.query }}"},
            {"name": "stream", "value": false}
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-56, -96],
      "id": "d1e2f3a4-0010-4000-8000-000000000010",
      "name": "call-tier2"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}"},
            {"name": "anthropic-version", "value": "2023-06-01"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "claude-opus-4-7"},
            {"name": "max_tokens", "value": 2048},
            {"name": "messages", "value": "=[{\"role\": \"user\", \"content\": \"{{ $json.query }}\"}]"}
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-56, 96],
      "id": "d1e2f3a4-0011-4000-8000-000000000011",
      "name": "call-tier3"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst tier = $('dispatch-tier').first().json?.tier || $('parse-classification').first().json?.tier || 0;\nconst answer = input.response || input.content?.[0]?.text || input.text || '';\nreturn [{\n  json: {\n    answer: answer.trim(),\n    tier,\n    query: $('normalize-route-payload').first().json.query,\n    model: tier === 1 ? 'gemma4:e4b' : tier === 2 ? 'gemma4:26b' : 'claude-opus-4-7'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [168, -96],
      "id": "d1e2f3a4-0012-4000-8000-000000000012",
      "name": "format-response"
    },
