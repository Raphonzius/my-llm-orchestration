      "name": "curate-chain"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.text || '';\nconst noteMatch = raw.match(/(---[\\s\\S]*)/);\nconst content = noteMatch ? noteMatch[1].trim() : raw.trim();\nreturn {\n  path: $('read-seed-note').item.json.path,\n  content\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [144, -96],
