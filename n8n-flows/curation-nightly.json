        "bodyParameters": {
          "parameters": [
            {"name": "path", "value": "={{ $json.path }}"},
            {"name": "content", "value": "={{ $json.content }}"}
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [368, -96],
      "id": "b1c2d3e4-0009-4000-8000-000000000009",
      "name": "write-curated"
    },
    {
      "parameters": {
        "jsCode": "const all = $input.all();\nreturn [{\n  json: {\n    curated: all.filter(i => i.json.action === 'curated').length,\n    total: all.length\n  }\n}];"
      },
