[Unit]
Description=GitHub CLI Auth for Nexus
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/nexus/gh-token

[Service]
Type=oneshot
User=raphonzius
ExecStart=/bin/bash -c 'gh auth login --with-token < /etc/nexus/gh-token'
RemainAfterExit=yes

[Install]
WantedBy=nexus.target
