[Unit]
Description=Nexus Docker Compose Stack (Ollama + Qdrant + n8n)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raphonzius
WorkingDirectory=/home/raphonzius/Projects/my-llm-orchestration/deploy
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=10

[Install]
WantedBy=nexus.target
